# Razorpay - Dashboard > Account & Settings > API Keys, mode = TEST. No KYC needed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Resend. Referenced from vendors.yaml as `env:RESEND_API_KEY` so the key stays here
# rather than in a file you might share. Writing the token into vendors.yaml directly
# works too, and is the thing to avoid before showing anyone your screen.
RESEND_API_KEY=

# OBSERVE blocks nothing and is the right place to start. docker compose reads this.
COMMONS_MODE=OBSERVE

# LLM providers. Only examples/example_agent.py reads these; the gateway needs none.
# NOTE: Cerebras free tier was withdrawn (402 Payment Required) - do not re-add.
GROQ_API_KEY=          # Cart Recovery            -> openai/gpt-oss-120b
GOOGLE_API_KEY=        # Sub Recovery / Dispute / RTO / personas -> gemini flash family
OPENROUTER_API_KEY=    # frontier control run     -> nemotron-3-ultra-550b:free
