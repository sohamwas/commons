# Copy this to .env and fill in what you have. Copying it unchanged is safe: every value
# below is commented out, so Commons starts with no vendors rather than with one that is
# half-configured. A key id without its secret looks configured and cannot authenticate.

# Razorpay - Dashboard > Account & Settings > API Keys, mode = TEST. No KYC needed.
# Both lines are required together. Commons refuses to start against a live key, because
# it forwards real write calls.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=

# Resend. Reference it from vendors.yaml as `env:RESEND_API_KEY` so the key stays here
# rather than in a file you might share or screen-share.
# RESEND_API_KEY=

# OBSERVE blocks nothing and is the right place to start. Read by scripts/start.py,
# which also takes --mode on the command line.
# COMMONS_MODE=OBSERVE

# LLM providers. Only examples/example_agent.py reads these; the gateway needs none.
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
