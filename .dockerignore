# Keep the build context small and keep secrets and local state out of the image.
#
# .env especially: compose injects the keys as environment variables at RUN time, which
# is the difference between a secret the container reads and a secret baked into a layer
# that anyone who pulls the image can recover.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local state. These are the merchant's, and each is recreated on first run.
*.db
*.db-shm
*.db-wal
agents.yaml
vendors.yaml
outbox.jsonl
*.log

# The dashboard has its own image and its own context.
dashboard/

.git/
.gitignore
runs/
